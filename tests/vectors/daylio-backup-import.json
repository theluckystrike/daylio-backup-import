  {
   "name": "case 8: version 16 is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":16,\"dayEntries\":[]}"
   ],
   "expected": {
    "error": "Unsupported Daylio schema version 16. This plugin reads version 15 only."
   }
  },
  {
   "name": "missing version is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"dayEntries\":[]}"
   ],
   "expected": {
    "error": "Unsupported Daylio schema version (missing). This plugin reads version 15 only."
   }
  },
  {
   "name": "version as a string is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":\"15\",\"dayEntries\":[]}"
   ],
   "expected": {
    "error": "Unsupported Daylio schema version \"15\". This plugin reads version 15 only."
   }
  },
  {
   "name": "duplicate entry IDs are rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15,\"customMoods\":[{\"id\":6,\"custom_name\":\"calm\",\"predefined_name_id\":-1}],\"tags\":[{\"id\":179,\"name\":\"long walk\"}],\"assets\":[],\"dayEntries\":[{\"id\":1,\"datetime\":1700408759432,\"timeZoneOffset\":-18000000,\"mood\":0,\"note\":\"\",\"note_title\":\"\",\"tags\":[],\"assets\":[]},{\"id\":1,\"datetime\":1700408759432,\"timeZoneOffset\":-18000000,\"mood\":0,\"note\":\"\",\"note_title\":\"\",\"tags\":[],\"assets\":[]}]}"
   ],
   "expected": {
    "error": "Duplicate entry ID 1."
   }
  },
  {
   "name": "invalid JSON is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15,"
   ],
   "expected": {
    "error": "The backup payload is not valid JSON."
   }
  },
  {
   "name": "missing dayEntries list is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15}"
   ],
   "expected": {
    "error": "The backup has no dayEntries list."
   }
  },
  {
   "name": "asset checksum with a parent step is rejected",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15,\"customMoods\":[{\"id\":6,\"custom_name\":\"calm\",\"predefined_name_id\":-1}],\"tags\":[{\"id\":179,\"name\":\"long walk\"}],\"assets\":[{\"id\":1,\"checksum\":\"../x\",\"type\":1}],\"dayEntries\":[]}"
   ],
   "expected": {
    "error": "Asset 1 has an unsafe checksum."
   }
  },
