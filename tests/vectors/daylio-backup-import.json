   "name": "empty entry list gives no entries",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15,\"customMoods\":[{\"id\":6,\"custom_name\":\"calm\",\"predefined_name_id\":-1}],\"tags\":[{\"id\":179,\"name\":\"long walk\"}],\"assets\":[],\"dayEntries\":[]}"
   ],
   "expected": {
    "version": 15,
    "entries": [],
    "assets": [],
    "warnings": []
   }
  },
  {
   "name": "case 8: member ../outside.md is rejected",
   "function": "checkArchive",
   "args": [
    1000,
    [
     "backup.daylio",
     "../outside.md"
    ],
    [
     10,
     10
    ]
   ],
   "expected": "The backup has an unsafe archive path: ../outside.md"
  },
  {
