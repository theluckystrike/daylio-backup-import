{
 "slug": "daylio-backup-import",
 "module": "daylio-backup-import/src/backup",
 "function": "inspectPayload",
 "note": "Each case names its exported function. tests/vectors.test.ts runs each case. Acceptance cases 1, 2, 6 and 7 also run against a vault in tests/plugin.test.ts.",
 "cases": [
  {
   "name": "case 1 and 2: fixture payload gives entries 15024 and 15025 with one photo reference",
   "function": "inspectPayload",
   "args": [
    "{\"version\":15,\"customMoods\":[{\"id\":1,\"custom_name\":\"\",\"mood_group_id\":1,\"predefined_name_id\":1,\"state\":0},{\"id\":2,\"custom_name\":\"\",\"mood_group_id\":2,\"predefined_name_id\":2,\"state\":0},{\"id\":3,\"custom_name\":\"\",\"mood_group_id\":3,\"predefined_name_id\":3,\"state\":0},{\"id\":4,\"custom_name\":\"\",\"mood_group_id\":4,\"predefined_name_id\":4,\"state\":0},{\"id\":5,\"custom_name\":\"\",\"mood_group_id\":5,\"predefined_name_id\":5,\"state\":0},{\"id\":6,\"custom_name\":\"calm\",\"mood_group_id\":2,\"predefined_name_id\":-1,\"state\":0}],\"tags\":[{\"id\":179,\"name\":\"long walk\",\"order\":1,\"state\":0},{\"id\":180,\"name\":\"reading\",\"order\":2,\"state\":0}],\"assets\":[{\"id\":1,\"checksum\":\"a3f1c0de5b7e4c2d9e8f\",\"type\":1,\"createdAt\":1700408759432}],\"dayEntries\":[{\"id\":15024,\"minute\":45,\"hour\":10,\"day\":19,\"month\":10,\"year\":2023,\"datetime\":1700408759432,\"timeZoneOffset\":-18000000,\"mood\":1,\"note\":\"Hello <strong>world</strong>\",\"note_title\":\"Same title\",\"tags\":[179],\"assets\":[1]},{\"id\":15025,\"minute\":45,\"hour\":10,\"day\":19,\"month\":10,\"year\":2023,\"datetime\":1700408759432,\"timeZoneOffset\":-18000000,\"mood\":6,\"note\":\"第二条 😀\",\"note_title\":\"Same title\",\"tags\":[180],\"assets\":[]}],\"metadata\":{\"number_of_entries\":2,\"number_of_photos\":1,\"platform\":\"android\"}}"
   ],
   "expected": {
    "version": 15,
    "entries": [
     {
      "id": 15024,
      "title": "Same title",
      "note": "Hello <strong>world</strong>",
      "datetime": 1700408759432,
      "offsetMs": -18000000,
      "date": "2023-11-19",
      "time": "10:45",
      "local": "2023-11-19 10:45:59.432",
      "offset": "-05:00",
      "moodId": 1,
      "mood": "rad",
      "activities": [
       "long walk"
      ],
      "assets": [
       1
      ]
     },
     {
      "id": 15025,
      "title": "Same title",
      "note": "第二条 😀",
      "datetime": 1700408759432,
      "offsetMs": -18000000,
      "date": "2023-11-19",
      "time": "10:45",
      "local": "2023-11-19 10:45:59.432",
      "offset": "-05:00",
      "moodId": 6,
      "mood": "calm",
      "activities": [
       "reading"
      ],
      "assets": []
     }
    ],
    "assets": [
     {
      "id": 1,
      "checksum": "a3f1c0de5b7e4c2d9e8f",
      "type": 1
     }
    ],
    "warnings": []
   }
  },
  {
   "name": "case 3: datetime 1700408759432 with offset -18000000 is 2023-11-19 10:45:59.432 at -05:00",
   "function": "localTime",
   "args": [
    1700408759432,
    -18000000
   ],
   "expected": {
    "date": "2023-11-19",
    "time": "10:45",
    "local": "2023-11-19 10:45:59.432",
    "offset": "-05:00"
   }
  },
  {
   "name": "half hour offset +05:30",
   "function": "localTime",
   "args": [
    0,
    19800000
   ],
   "expected": {
    "date": "1970-01-01",
    "time": "05:30",
    "local": "1970-01-01 05:30:00.000",
    "offset": "+05:30"
   }
  },
  {
   "name": "offset moves the local date to the previous day",
   "function": "localTime",
   "args": [
    1700352000000,
    -3600000
   ],
   "expected": {
    "date": "2023-11-18",
    "time": "23:00",
    "local": "2023-11-18 23:00:00.000",
    "offset": "-01:00"
   }
  },
