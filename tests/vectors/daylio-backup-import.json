  {
   "name": "daily section is added when the heading is missing",
   "function": "mergeSection",
   "args": [
    "# 2023-11-19\n\nMorning text.\n",
    "Daylio",
    [
     "- 10:45 · rad [[Daylio/2023-11-19 Daylio 15024|Daylio 15024]] ^daylio-15024"
    ]
   ],
   "expected": {
    "text": "# 2023-11-19\n\nMorning text.\n\n## Daylio\n\n- 10:45 · rad [[Daylio/2023-11-19 Daylio 15024|Daylio 15024]] ^daylio-15024\n",
    "added": 1
   }
  },
  {
   "name": "daily lines go at the end of the named section before the next heading",
   "function": "mergeSection",
   "args": [
    "## Daylio\n\n- old line\n\n## Tasks\n\n- [ ] task\n",
    "Daylio",
    [
     "- new ^daylio-2"
    ]
   ],
   "expected": {
    "text": "## Daylio\n\n- old line\n- new ^daylio-2\n\n## Tasks\n\n- [ ] task\n",
    "added": 1
   }
  },
  {
   "name": "case 7: a second merge with the same block ID adds nothing",
   "function": "mergeSection",
   "args": [
    "## Daylio\n\n- 10:45 ^daylio-15024\n",
    "Daylio",
    [
     "- 10:45 ^daylio-15024"
    ]
   ],
   "expected": {
    "text": "## Daylio\n\n- 10:45 ^daylio-15024\n",
    "added": 0
   }
  },
