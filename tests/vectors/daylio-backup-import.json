     "backup.daylio",
     "C:/outside.md"
    ],
    [
     10,
     10
    ]
   ],
   "expected": "The backup has an unsafe archive path: C:/outside.md"
  },
  {
   "name": "duplicate member names are rejected",
   "function": "checkArchive",
   "args": [
    1000,
    [
     "backup.daylio",
     "backup.daylio"
    ],
    [
     10,
     10
    ]
   ],
   "expected": "The backup has a duplicate archive name: backup.daylio"
  },
  {
   "name": "case 9: compressed size above 20 MiB is rejected",
   "function": "checkArchive",
   "args": [
    20971521,
    [
     "backup.daylio"
    ],
    [
     10
    ]
   ],
   "expected": "The backup exceeds the 20 MiB compressed size limit."
  },
  {
   "name": "case 9: declared expanded size above 100 MiB is rejected",
   "function": "checkArchive",
   "args": [
    1000,
    [
     "backup.daylio",
     "assets/photos/a"
    ],
    [
     52428800,
     52428801
    ]
   ],
   "expected": "The backup declares more than the 100 MiB expanded size limit."
  },
  {
   "name": "a valid member list passes",
   "function": "checkArchive",
   "args": [
    1000,
    [
     "backup.daylio",
     "assets/photos/2023/11/a3f1c0de5b7e4c2d9e8f"
    ],
    [
     10,
     10
    ]
   ],
   "expected": ""
